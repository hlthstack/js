{
  "name": "hlthstack",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript client for the hlthstack partner REST API (server-side).",
  "license": "MIT",
  "author": "hlthstack",
  "homepage": "https://github.com/hlthstack/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlthstack/js.git"
  },
  "bugs": {
    "url": "https://github.com/hlthstack/js/issues"
  },
  "keywords": [
    "hlthstack",
    "health",
    "api",
    "client",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/openapi.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
